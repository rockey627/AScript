		<ProjectReference Include="..\AScript.Lang.JavaScript\AScript.Lang.JavaScript.csproj" />
		<ProjectReference Include="..\AScript.Lang.Lua.io\AScript.Lang.Lua.io.csproj" />
		<ProjectReference Include="..\AScript.Lang.Lua\AScript.Lang.Lua.csproj" />
		<ProjectReference Include="..\AScript.Lang.Python3\AScript.Lang.Python3.csproj" />
		<ProjectReference Include="..\AScript.Lang.Sql\AScript.Lang.Sql.csproj" />
		<ProjectReference Include="..\AScript\AScript.csproj" />
	</ItemGroup>

	<ItemGroup>
