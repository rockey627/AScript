	  </Reference>
	  <Reference Include="Aprillz.MewUI.Backend.Direct2D">
	    <HintPath>dlls\Aprillz.MewUI.Backend.Direct2D.dll</HintPath>
	  </Reference>
	  <Reference Include="Aprillz.MewUI.MewvalonEdit">
	    <HintPath>dlls\Aprillz.MewUI.MewvalonEdit.dll</HintPath>
	  </Reference>
	  <Reference Include="Aprillz.MewUI.Platform.Win32">
	    <HintPath>dlls\Aprillz.MewUI.Platform.Win32.dll</HintPath>
	  </Reference>
